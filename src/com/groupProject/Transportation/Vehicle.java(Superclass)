package transport;

// Abstract because we don't just have a generic "vehicle" 
// It's always either a Combi or a Taxi
public abstract class Vehicle {
    protected String routeName;
    protected double baseFare;

    public Vehicle(String routeName, double baseFare) {
        this.routeName = routeName;
        this.baseFare = baseFare;
    }

    // Every vehicle calculates fare differently
    public abstract double calculateFare(int numTrips);

    public String getRouteName() {
        return routeName;
    
    }
}
